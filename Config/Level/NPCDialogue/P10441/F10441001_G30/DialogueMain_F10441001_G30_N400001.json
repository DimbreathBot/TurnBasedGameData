{
  "OnInitSequece": [],
  "OnStartSequece": [
    {
      "TaskList": [
        {
          "$type": "RPG.Client.EnableElfEnvironment",
          "Enable": true
        },
        {
          "$type": "RPG.GameCore.ShowUI",
          "Name": "Ui.Activity.ElfRestaurant.Entrance.ElfRestaurantEntrancePage",
          "WaitForExit": true,
          "OnUIEnter": [
            {
              "$type": "RPG.GameCore.TriggerCustomString",
              "CustomString": {
                "Value": "ElfEntranceEnter"
              }
            }
          ],
          "OnUIExitImmediately": [
            {
              "$type": "RPG.GameCore.TriggerCustomString",
              "CustomString": {
                "Value": "ElfEntranceExit"
              }
            }
          ]
        }
      ]
    },
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.WaitCustomString",
          "CustomString": {
            "Value": "ElfEntranceEnter"
          },
          "WaitOwnerOnly": true,
          "GoNextImmediately": true,
          "ResetWhenTaskBegin": true
        },
        {
          "$type": "RPG.GameCore.BlockInputController",
          "Enable": true,
          "ActionNameList": []
        },
        {
          "$type": "RPG.GameCore.SetLocalPlayerDitherAlpha"
        },
        {
          "$type": "RPG.GameCore.LockPlayerControl"
        }
      ]
    },
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.WaitCustomString",
          "CustomString": {
            "Value": "ElfEntranceExit"
          },
          "WaitOwnerOnly": true,
          "GoNextImmediately": true,
          "ResetWhenTaskBegin": true
        },
        {
          "$type": "RPG.Client.EnableElfEnvironment"
        },
        {
          "$type": "RPG.GameCore.SetLocalPlayerDitherAlpha",
          "DitherAlpha": 1
        },
        {
          "$type": "RPG.GameCore.UnLockPlayerControl"
        },
        {
          "$type": "RPG.GameCore.BlockInputController",
          "ActionNameList": []
        }
      ]
    }
  ],
  "EntityEventList": []
}