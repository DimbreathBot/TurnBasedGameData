          ],
          "OnExit": [
            {
              "$type": "RPG.GameCore.SetClientGroupProperty",
              "DynamicName": {
                "Value": "IsIn5D"
              }
            }
          ]
        }
      ]
    }
  ],
  "ValueSource": {
    "Values": [
      {
        "$type": "RPG.GameCore.SharedJsonConfig",
        "Value": {
          "$type": "RPG.GameCore.GameLevelObjectRefConfig"
