{
  "Desc": "赛段中部分区域将变为低重力环境",
  "OnUse": [
    {
      "$type": "RPG.GameCore.CakeRaceActionTriggerActionOnFight",
      "TriggerType": "FightEffectShow",
      "ShowDurationMs": 2000,
      "ExecuteBeforeBeginDelay": true,
      "Action": {
        "$type": "RPG.GameCore.CakeRaceActionSpawnAoeOnCurSectionRows",
        "Rows": 10,
        "AoeConfig": {
          "ShowType": "GravityDecrease",
          "EnterActions": [
            {
              "$type": "RPG.GameCore.CakeRaceActionPropertyModifier",
              "PropertyModifiers": [
                {
                  "Property": "GravityDecCounter",
                  "Operation": "Add",
                  "Value": 1
                }
              ]
            }
          ],
          "LeaveActions": [
            {
              "$type": "RPG.GameCore.CakeRaceActionPropertyModifier",
              "PropertyModifiers": [
                {
                  "Property": "GravityDecCounter",
                  "Operation": "Sub",
                  "Value": 1
                }
              ]
            },
            {
              "$type": "RPG.GameCore.CakeRaceActionSuddenGravityAdd"
            }
          ]
        }
      }
    }
  ]
}